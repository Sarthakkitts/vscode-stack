 New Roman"/></a:rPr><a:t>0 represents a positive number while</a:t></a:r><a:endParaRPr sz="2400" b="0" i="0" u="none" strike="noStrike" cap="none"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Times New Roman"/><a:ea typeface="Times New Roman"/><a:cs typeface="Times New Roman"/><a:sym typeface="Times New Roman"/></a:endParaRPr></a:p><a:p><a:pPr marL="727710" marR="0" lvl="1" indent="-358775" algn="l" rtl="0"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="1000"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="2400"/><a:buFont typeface="Noto Sans Symbols"/><a:buChar char="✔"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="0" i="0" u="none" strike="noStrike" cap="none"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Times New Roman"/><a:ea typeface="Times New Roman"/><a:cs typeface="Times New Roman"/><a:sym typeface="Times New Roman"/></a:rPr><a:t>1 represents a negative number.</a:t></a:r><a:endParaRPr sz="2400" b="0" i="0" u="none" strike="noStrike" cap="none"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Times New Roman"/><a:ea typeface="Times New Roman"/><a:cs typeface="Times New Roman"/><a:sym typeface="Times New Roman"/></a:endParaRPr></a:p><a:p><a:pPr marL="311150" marR="0" lvl="0" indent="-299085" algn="l" rtl="0"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="994"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="2400"/><a:buFont typeface="Times New Roman"/><a:buAutoNum type="arabicPeriod"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Times New Roman"/><a:ea typeface="Times New Roman"/><a:cs typeface="Times New Roman"/><a:sym typeface="Times New Roman"/></a:rPr><a:t>The Biased exponent</a:t></a:r><a:endParaRPr sz="2400"><a:solidFill><a:schemeClr val="dk1"/>